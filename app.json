{
  "expo": {
    "name": "Challenge Ford - AutoBench",
    "slug": "challenge-ford-autobench",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/autobench-app-icon-a.png",
    "scheme": "challenge-ford-autobench",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#001A4D",
        "foregroundImage": "./assets/images/autobench-app-icon-a.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/autobench-vertical-padrao.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
